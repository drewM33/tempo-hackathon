# Copy to .env.local and adjust. Next.js loads .env.local automatically.
#
# Turn on live Valiron Operator API (wallet profiles, health route, chat `trust`).
VALIRON_ENABLED=true

# Default chain for the SDK (ethereum, base, monad, arbitrum, …)
VALIRON_CHAIN=ethereum

# Optional: override operator edge (defaults to Valiron production proxy)
# VALIRON_ENDPOINT=https://valiron-edge-proxy.onrender.com

# Agent ID used only by GET /api/valiron/health (ERC-8004 id, not wallet)
VALIRON_HEALTH_AGENT_ID=25459

# Poll interval for merging wallet trust into dashboard rows (ms)
VALIRON_REFRESH_MS=90000

# Optional: comma-separated full wallets (0x + 40 hex) to seed the 9 dashboard rows
# VALIRON_WALLETS=0x0000000000000000000000000000000000000001

# VALIRON_TIMEOUT_MS=8000
# VALIRON_DEBUG=true
